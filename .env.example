NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
OVERLAY_TOKEN_SECRET=
VIEWER_SESSION_SECRET=
SIGNVRSE_API_BASE_URL=https://api.signvrse.com
SIGNVRSE_API_KEY=
SIGNVRSE_TRANSPORT=websocket
AWS_REGION=eu-west-1
# Local short-lived credentials: aws login --profile signcast-developer --region eu-west-1
AWS_PROFILE=signcast-runtime
# In AWS hosting use a task/instance role instead of keys or a local profile.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
TWITCH_EXTENSION_CLIENT_ID=
# Base64 extension secret from Twitch Developer Console; different from OAuth secret.
TWITCH_EXTENSION_SECRET=
TWITCH_EXTENSION_ALLOWED_ORIGINS=
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost:5174
MOCK_PROVIDERS=false
# Public URL only. Used when packaging the extension; never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:3000
